    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery/Animal_based_Ingredients -->

    <owl:Class rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Animal_based_Ingredients">
