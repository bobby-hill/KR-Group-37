    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery/Product_Types -->

    <owl:Class rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Product_Types">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Food"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery/Salty_Ingredient -->

    <owl:Class rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Salty_Ingredient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Ingredient"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery/Sandwich -->

    <owl:Class rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Sandwich">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Product_Types"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery/Savoury_Product -->

    <owl:Class rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Savoury_Product">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Food"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#hasIngredient"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Salty_Ingredient"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Food"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery/SpecialProduct -->

    <owl:Class rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/SpecialProduct">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Product_Types"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery/Sweet_Ingredient -->

    <owl:Class rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Sweet_Ingredient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Ingredient"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery/Sweet_Product -->

    <owl:Class rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Sweet_Product">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Food"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#hasIngredient"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Sweet_Ingredient"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Food"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery/Vegan_Product -->

    <owl:Class rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Vegan_Product">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Food"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery/Vegetarian_Product -->

    <owl:Class rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Vegetarian_Product">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Food"/>
                    <owl:Class>
                        <owl:complementOf>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#hasIngredient"/>
                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Meat_Ingredient"/>
                            </owl:Restriction>
                        </owl:complementOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Food"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery/containsGluten -->

    <owl:Class rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/containsGluten">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Filling"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Ingredient"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Food"/>
                        </owl:unionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#hasFilling"/>
                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/containsGluten"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#hasIngredient"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Gluten"/>
                                            <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/containsGluten"/>
                                        </owl:unionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Allergen"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery/containsLactose -->

    <owl:Class rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/containsLactose">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Filling"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Ingredient"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Food"/>
                        </owl:unionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#hasFilling"/>
                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/containsLactose"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#hasIngredient"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Lactose"/>
                                            <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/containsLactose"/>
                                        </owl:unionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Allergen"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery/containsNuts -->

    <owl:Class rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/containsNuts">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Filling"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Ingredient"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Food"/>
                        </owl:unionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#hasFilling"/>
                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/containsNuts"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#hasIngredient"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Nuts"/>
                                            <rdf:Description rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/containsNuts"/>
                                        </owl:unionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Allergen"/>
    </owl:Class>
    


