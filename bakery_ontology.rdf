    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery/Meat_Ingredient -->

    <owl:Class rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Meat_Ingredient">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Animal_based_Ingredients"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery/Nuts -->

    <owl:Class rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Nuts">
