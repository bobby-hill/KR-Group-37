    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery#AlmondCream -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery#AlmondCream">
        <rdf:type rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Filling"/>
        <bakery:hasIngredient rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#AlmondMeal"/>
        <bakery:hasIngredient rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Butter"/>
        <bakery:hasIngredient rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Egg"/>
        <bakery:hasIngredient rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Sugar"/>
        <rdfs:label xml:lang="en">Almond cream</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery#AlmondCroissant -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery#AlmondCroissant">
        <rdf:type rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Croissant"/>
        <bakery:hasFilling rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#AlmondCream"/>
        <bakery:hasIngredient rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Butter"/>
        <bakery:hasIngredient rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Milk"/>
        <bakery:hasIngredient rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Salt"/>
        <bakery:hasIngredient rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#WheatFlour"/>
        <bakery:hasIngredient rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Yeast"/>
        <bakery:preparedBy rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#NoahReed"/>
        <rdfs:label xml:lang="en">Almond croissant</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery#AlmondMeal -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery#AlmondMeal">
        <rdf:type rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Ingredient"/>
        <bakery:hasIngredient rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery/Almond"/>
        <rdfs:label xml:lang="en">Almond meal</rdfs:label>
