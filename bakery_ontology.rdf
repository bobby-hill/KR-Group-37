    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery#hasFilling -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery#hasFilling"/>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery#hasFlavour -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery#hasFlavour">
        <rdfs:range rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Flavour"/>
        <rdfs:label xml:lang="en">has flavour</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery#hasIngredient -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery#hasIngredient">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Ingredient"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/37/ontologies/2026/11/bakery#preparedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/37/ontologies/2026/11/bakery#preparedBy">
        <rdfs:range rdf:resource="http://www.semanticweb.org/37/ontologies/2026/11/bakery#Employee"/>
        <rdfs:label xml:lang="en">prepared by</rdfs:label>
    </owl:ObjectProperty>
    


